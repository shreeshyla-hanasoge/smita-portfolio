# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---------------------------------------------------------------- payments
# Razorpay publishable key. This is the ONLY switch that opens the shop's
# checkout: with it unset the shop stays browsable but cannot take money.
#
#   rzp_test_...  test mode, no real money. Available the moment you sign up.
#   rzp_live_...  live mode. Needs KYC/activation to be complete.
#
# This key is public by design — it ends up in the built JavaScript, which is
# fine and expected. The KEY SECRET is the one that must never appear here or
# anywhere in this repository.
VITE_RAZORPAY_KEY_ID=

# --------------------------------------------------------------- email
# EmailJS, used by the contact form (and, once E9.5 lands, order confirmations).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
